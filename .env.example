# Zoey's settings. Copy this file to .env and fill it in:
#     cp .env.example .env
# .env is git-ignored, so your keys never get committed or pushed.

# --- Required -------------------------------------------------------------
ANTHROPIC_API_KEY=           # console.anthropic.com -> API Keys

# --- You ------------------------------------------------------------------
ZOEY_USER_NAME=Hunter        # what she calls you
ZOEY_HOME_CITY=              # e.g. Tampa (default city for weather)

# --- Voice (only for --voice) --------------------------------------------
ELEVENLABS_API_KEY=          # elevenlabs.io -> Developers -> API Keys
ELEVENLABS_VOICE_ID=         # the voice you designed for her
PICOVOICE_ACCESS_KEY=        # console.picovoice.ai
PORCUPINE_KEYWORD_PATH=      # full path to your Hey-Zoey .ppn file

# --- Optional tuning --------------------------------------------------------
# ZOEY_EFFORT=low                  # low / medium / high thinking
# ZOEY_WHISPER_MODEL=small.en      # base.en is faster, large-v3-turbo more accurate
# ELEVENLABS_MODEL=eleven_flash_v2_5
# ZOEY_SESSION_IDLE_MINUTES=15     # quiet time before she files a conversation away
# ZOEY_KEEP_AWAKE=1                # 1 = stop the Mac from idle-sleeping while she runs
